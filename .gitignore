.DS_Store

__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
# Root-anchored: build output only, not source packages named "build".
/build/

.venv/
venv/

# Operator-selected local reference snapshots (see data/external/README.md).
data/external/*
!data/external/README.md

data/runs/
data/pilot-results*.json

.pytest_cache/
.coverage
# Per-worker coverage data from parallel runs. As untracked files they would
# change the working-tree fingerprint in run code provenance mid-session.
.coverage.*
htmlcov/

.claude/

.env

# External references (textbooks, PDFs, raw markdown conversions).
references/*
!references/calibration/
!references/calibration/**

.idea/
.vscode/
*.swp
*.swo
.obsidian/


# Generated by the documented coverage measurement command.
coverage.json
